#!/bin/bash
# Installs the agent globally so it works in any Rails repo with nothing copied in:
# links this repo to ~/.kiro/lean-rails and writes ~/.kiro/agents/rails.json.
# Rerun after pulling changes to agent.json.
set -e
kiro=${KIRO_HOME:-$HOME/.kiro}
repo=$(cd "$(dirname "$0")/.." && pwd)
link="$kiro/lean-rails"
config="$kiro/agents/rails.json"

if [ -e "$link" ] && [ ! -L "$link" ]; then
  echo "$link exists and is not a symlink; move it aside first" >&2; exit 1
fi
if [ -f "$config" ] && ! grep -q 'lean-rails' "$config"; then
  echo "$config exists and is not this agent; move it aside first" >&2; exit 1
fi

mkdir -p "$kiro/agents"
ln -sfn "$repo" "$link"
# Resource URIs are not run through a shell, so expand ~ here rather than trust Kiro to
sed "s#~/\.kiro#$kiro#g" "$repo/agent.json" > "$config"

command -v rg >/dev/null || echo "note: install ripgrep (brew install ripgrep); the guards point the agent at rg"
kiro-cli agent validate --path "$config"
echo "installed: kiro-cli chat --agent rails  (or: kiro-cli agent set-default rails)"
