#!/bin/bash
# Kiro agentSpawn hook: prints session facts so the agent skips discovery turns.
# Runs once when the agent starts. Edit to match your project's stack.
root=$(cd "$(dirname "$0")/.." && pwd); cd "$root" || exit 0
rm -f tmp/.full_suite_ran

echo "cwd: $root (never prefix commands with cd)"
echo "branch: $(git rev-parse --abbrev-ref HEAD)  $(git status --short | wc -l | tr -d ' ') uncommitted files"
echo "ruby: $(ruby -v 2>/dev/null | cut -d' ' -f2)"
echo "recent: $(git log --oneline -3 | tr '\n' '|')"

pending=$(bundle exec rails db:migrate:status 2>/dev/null | grep -c '^\s*down' || echo 0)
[ "$pending" -gt 0 ] && echo "WARNING: $pending pending migrations (run rails db:migrate before testing)"

for p in 3000 3001 3002; do
  pid=$(lsof -nP -iTCP:$p -sTCP:LISTEN -t 2>/dev/null | head -1)
  [ -n "$pid" ] && echo "port $p: $(ps -o command= -p "$pid" | cut -c1-60)"
done

echo "dev: bin/dev or rails server (:3000) — not started automatically"
echo "test: bundle exec rspec <file:line> for one spec, bundle exec rspec for the suite"
exit 0
