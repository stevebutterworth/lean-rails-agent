#!/bin/bash
# Compact rubocop for the agent: one line per offense (file:line:col: message).
#   bin/lint            lint Ruby files changed vs the default branch, plus uncommitted
#   bin/lint -a         same, with safe autocorrect
#   bin/lint [-a] FILE  lint the given files
flags=(); files=()
for arg in "$@"; do
  case "$arg" in -*) flags+=("$arg") ;; *) files+=("$arg") ;; esac
done

if [ ${#files[@]} -eq 0 ]; then
  base=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo main)
  while IFS= read -r f; do
    [ -f "$f" ] && files+=("$f")
  done < <({ git diff --name-only "$base"...HEAD 2>/dev/null
             git diff --name-only HEAD
             git ls-files --others --exclude-standard; } |
           grep -E '\.(rb|rake|ru)$|(^|/)(Gemfile|Rakefile)$' | sort -u)
  [ ${#files[@]} -eq 0 ] && { echo "no changed Ruby files"; exit 0; }
fi

# --force-exclusion keeps .rubocop.yml Exclude working with explicit paths
bundle exec rubocop --format emacs --force-exclusion "${flags[@]}" "${files[@]}" 2>&1 | head -n 60
exit "${PIPESTATUS[0]}"
