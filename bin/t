#!/bin/bash
# Compact rspec for the agent: bin/t [spec/file.rb:LINE ...]
# Keeps failure details, the summary and the rerun list; drops the dot line,
# the Pending section and blank lines, and caps output at 80 lines.
# Not --format failures: it prints example names without the error and
# silently swallows load errors (rspec-core 3.13).
out=$(bundle exec rspec --format progress "$@" 2>&1)
status=$?
out=$(printf '%s\n' "$out" | awk '
  /^[.*F]+$/ { next }
  /^Pending:/ { skip = 1; next }
  /^Failures:/ || /^Finished in/ { skip = 0 }
  skip { next }
  /^ *$/ || /^Finished in/ || /^Failed examples:/ || /\(compared using/ { next }
  { print }
')
lines=$(printf '%s\n' "$out" | wc -l | tr -d ' ')
if [ "$lines" -gt 80 ]; then
  printf '%s\n' "$out" | head -n 60
  echo "... $((lines - 80)) lines cut; rerun one file for full detail ..."
  printf '%s\n' "$out" | tail -n 20
else
  printf '%s\n' "$out"
fi
exit $status
