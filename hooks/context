#!/bin/bash
# Kiro agentSpawn hook: prints session facts so the agent skips discovery turns.
# Runs once when the agent starts, in the directory Kiro was launched from.
# Commands live in rules.md; do not repeat them here.
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd); cd "$root" || exit 0
state="${TMPDIR:-/tmp}/lean-rails-agent/$(printf %s "$root" | tr / _)"
rm "$state.full_suite_ran" 2>/dev/null

[ -f config/application.rb ] || echo "WARNING: $root is not a Rails app root"
echo "cwd: $root (never prefix commands with cd)"
echo "branch: $(git rev-parse --abbrev-ref HEAD 2>/dev/null)  $(git status --short 2>/dev/null | wc -l | tr -d ' ') uncommitted files"
echo "ruby: $(ruby -v 2>/dev/null | cut -d' ' -f2)  tests: $([ -d spec ] && echo rspec || echo minitest)"
echo "recent: $(git log --oneline -3 2>/dev/null | tr '\n' '|')"

# Asks the database, not schema.rb: after a pull, schema.rb is current but the local DB is not
pending=$(bundle exec rails db:migrate:status 2>/dev/null | grep -cE '^\s*down')
[ "${pending:-0}" -gt 0 ] && echo "WARNING: $pending pending migrations (run rails db:migrate before testing)"

for p in 3000 3001 3002; do
  pid=$(lsof -nP -iTCP:$p -sTCP:LISTEN -t 2>/dev/null | head -1)
  [ -n "$pid" ] && echo "port $p: $(ps -o command= -p "$pid" | cut -c1-60)"
done
exit 0
