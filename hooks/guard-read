#!/bin/bash
# Kiro preToolUse hook for read_file and fs_read. Blocks whole-file reads of
# files over 200 lines when no line range is given, and deep directory
# listings. Forces grep-then-range discipline. Exit 2 blocks the read and
# shows the reason to the agent.
reason=$(python3 -c '
import json, os, sys
d = json.load(sys.stdin)
a = d.get("tool_input") or d.get("input") or d.get("args") or d
# Newer fs_read batches reads as {"operations": [...]}; older takes one flat op
for op in a.get("operations") or [a]:
    path = next((op[k] for k in ("path", "file_path", "targetFile", "filePath") if isinstance(op.get(k), str)), "")
    if not path: continue
    if op.get("mode") == "Directory":
        if int(op.get("depth") or 0) > 1:
            print("deep directory listing; use rg --files | rg <pattern>"); break
        continue
    ranged = any(k in op for k in ("start_line", "end_line", "startLine", "endLine", "offset", "limit", "line_range", "range"))
    if not ranged and os.path.isfile(path):
        n = sum(1 for _ in open(path, "rb"))
        if n > 200:
            print("%s is %d lines; rg -n for what you need, then read a line range" % (os.path.basename(path), n)); break
' 2>/dev/null)
[ -n "$reason" ] && { echo "blocked by guard-read: $reason" >&2; exit 2; }
exit 0
