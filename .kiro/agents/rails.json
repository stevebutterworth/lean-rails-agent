{
  "name": "rails",
  "description": "Lean Rails agent: token-efficient hooks, AGENTS.md loaded at spawn",
  "model": "auto",
  "tools": ["*"],
  "allowedTools": ["*"],
  "resources": [
    "file://AGENTS.md"
  ],
  "hooks": [
    {
      "name": "context",
      "trigger": "agentSpawn",
      "action": { "type": "command", "command": "bin/kiro-context" },
      "timeout": 15
    },
    {
      "name": "guard",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": { "type": "command", "command": "bin/kiro-guard" },
      "timeout": 10
    },
    {
      "name": "guard-read",
      "trigger": "preToolUse",
      "matcher": "read_file",
      "action": { "type": "command", "command": "bin/kiro-guard-read" },
      "timeout": 10
    },
    {
      "name": "guard-fs-read",
      "trigger": "preToolUse",
      "matcher": "fs_read",
      "action": { "type": "command", "command": "bin/kiro-guard-read" },
      "timeout": 10
    }
  ],
  "permissions": {
    "rules": [{ "capability": "all", "effect": "allow" }]
  },
  "includeMcpJson": false,
  "mcpServers": {}
}
